# Poświadczenie bazy danych PostgreSQL z integracji Vercel/Neon (produkcja).
DATABASE_URL=
# Lokalnie, gdy DATABASE_URL jest puste, PGlite zapisuje dane tutaj.
PGLITE_PATH=./data/leads
# Sekret chroniący cotygodniowy endpoint cron.
CRON_SECRET=zmien-na-dlugi-losowy-sekret
# Opcjonalne hasło do wewnętrznej aplikacji. Gdy puste, ochrona logowania jest wyłączona.
APP_PASSWORD=
# Opcjonalne rozszerzenia; podstawowy produkt ich nie wymaga.
SEARCH_API_KEY=
LLM_API_KEY=
